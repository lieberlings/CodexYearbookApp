{
  "name": "codex-yearbook-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "prestart": "node scripts/build-library.cjs",
    "start": "node scripts/start-development.cjs",
    "preandroid": "node scripts/build-library.cjs",
    "android": "expo run:android --variant developmentDebug --app-id com.lieber.yearbookapp.dev",
