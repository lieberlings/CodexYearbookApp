# Copy to .env (never commit .env) to turn on accounts, backup and sharing in
# development builds. Values are in the Supabase dashboard under
# Project Settings -> API. Use the anon/public key, never the service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
